{
  "entities": {
    "UnitKokurikulum": {
      "title": "UnitKokurikulum",
      "description": "Unit Kokurikulum SMK Madai (Kelab/Persatuan, Pasukan Badan Beruniform, Sukan/Permainan)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "nama": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "enum": ["Pasukan Badan Beruniform", "Kelab dan Persatuan", "Sukan dan Permainan"] },
        "guruPenasihat": { "type": "array" },
        "bilanganAhli": { "type": "number" },
        "bilanganPerjumpaan": { "type": "number" }
      },
      "required": ["id", "nama", "kategori"]
    },
    "MuridUnit": {
      "title": "MuridUnit",
      "description": "Ahli murid yang berdaftar bagi unit kokurikulum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "unitId": { "type": "string", "maxLength": 100 },
        "namaMurid": { "type": "string", "maxLength": 200 },
        "noKp": { "type": "string", "maxLength": 30 },
        "tingkatanKelas": { "type": "string", "maxLength": 50 },
        "jantina": { "type": "string", "enum": ["Lelaki", "Perempuan"] },
        "jawatan": { "type": "string", "maxLength": 100 },
        "tarikhDidaftar": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "unitId", "namaMurid"]
    },
    "RekodKokurikulum": {
      "title": "RekodKokurikulum",
      "description": "Rekod laporan aktiviti perjumpaan kokurikulum mingguan, penglibatan, atau pencapaian",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "unitId": { "type": "string", "maxLength": 100 },
        "namaUnit": { "type": "string", "maxLength": 200 },
        "kategoriUnit": { "type": "string", "maxLength": 100 },
        "jenisRekod": { "type": "string", "enum": ["Perjumpaan Mingguan", "Penglibatan", "Pencapaian"] },
        "perjumpaanKe": { "type": "number" },
        "tarikh": { "type": "string", "maxLength": 30 },
        "masaMula": { "type": "string", "maxLength": 20 },
        "masaTamat": { "type": "string", "maxLength": 20 },
        "tempat": { "type": "string", "maxLength": 200 },
        "objektif": { "type": "string", "maxLength": 1000 },
        "kehadiran": { "type": "object" },
        "kehadiranGuru": { "type": "array" },
        "refleksiAktiviti": { "type": "string", "maxLength": 2000 },
        "guruPelapor": { "type": "string", "maxLength": 200 },
        "gambarAktiviti": { "type": "array" },
        "status": { "type": "string", "enum": ["Draf", "Disahkan Guru Penasihat", "Disemak PK Kokum", "Ditolak / Perlu Pembetulan"] },
        "diciptaPada": { "type": "string", "maxLength": 50 },
        "dikemaskiniPada": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "unitId", "tarikh", "jenisRekod"]
    }
  },
  "firestore": {
    "/units/{unitId}": {
      "schema": { "$ref": "#/entities/UnitKokurikulum" },
      "description": "Koleksi data unit kokurikulum"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/MuridUnit" },
      "description": "Koleksi data pendaftaran murid dalam unit"
    },
    "/records/{recordId}": {
      "schema": { "$ref": "#/entities/RekodKokurikulum" },
      "description": "Koleksi rekod aktiviti perjumpaan kokurikulum"
    }
  }
}
